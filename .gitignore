@'
# IDE and editor files
.idea/
.vscode/
*.code-workspace

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
tmp/
temp/

# Python artifacts
__pycache__/
*.py[cod]
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding utf8 .gitignore
discovery.docker "local" {
	host = "unix:///var/run/docker.sock"

	// Keep collection focused on this assessment's application and NGINX tasks.
	filter {
		name   = "name"
		values = ["nginx"]
	}
}

discovery.relabel "nginx" {
	targets = discovery.docker.local.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/([^/]+)"
		target_label  = "container"
		replacement   = "$1"
	}
}

loki.source.docker "nginx" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.nginx.output
	labels     = {job = "nginx"}
	forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
	stage.json {
		expressions = {
			method       = "method",
			status       = "status",
			request_time = "request_time",
			uri          = "uri",
		}
	}

	stage.labels {
		values = {
			method = "",
			status = "",
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
